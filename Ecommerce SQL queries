--revenue by month 
SELECT
	EXTRACT(
		YEAR
		FROM
			TO_TIMESTAMP(INVOICEDATE, 'MM/DD/YYYY HH24:MI')
	) AS YEAR,
	EXTRACT(
		MONTH
		FROM
			TO_TIMESTAMP(INVOICEDATE, 'MM/DD/YYYY HH24:MI')
	) AS MONTH,
	SUM(QUANTITY * UNITPRICE) AS REVENUE_BY_MONTH
FROM
	ECOMMERCE
WHERE
	INVOICENO NOT LIKE 'C%'
	AND INVOICENO NOT LIKE 'A%'
	AND UNITPRICE > 0
	AND CUSTOMERID IS NOT NULL
GROUP BY
	YEAR,
	MONTH
ORDER BY
	YEAR,
	MONTH;

