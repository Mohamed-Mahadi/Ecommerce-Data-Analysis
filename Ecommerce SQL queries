--Data Quality Checks:
-- Missing Customer IDs
SELECT
	COUNT(*)
FROM
	ECOMMERCE
WHERE
	CUSTOMERID IS NULL;

-- Invalid Prices
SELECT
	COUNT(*)
FROM
	ECOMMERCE
WHERE
	UNITPRICE <= 0;

-- Cancelled Orders
SELECT
	COUNT(DISTINCT INVOICENO)
FROM
	ECOMMERCE
WHERE
	INVOICENO LIKE 'C%';

--Total revenue: 
SELECT
	ROUND(SUM(QUANTITY * UNITPRICE)::NUMERIC, 2) AS REVENUE
FROM
	ECOMMERCE
WHERE
	INVOICENO NOT LIKE 'C%'
	AND INVOICENO NOT LIKE 'A%'
	AND UNITPRICE > 0
	AND CUSTOMERID IS NOT NULL;

--unique orders: 
SELECT
	COUNT(DISTINCT INVOICENO) AS UNIQUE_ORDERS
FROM
	ECOMMERCE
WHERE
	INVOICENO NOT LIKE 'C%'
	AND INVOICENO NOT LIKE 'A%'
	AND UNITPRICE > 0
	AND CUSTOMERID IS NOT NULL;

--unique customers
SELECT
	COUNT(DISTINCT CUSTOMERID) AS UNIQUE_CUSTOMERS
FROM
	ECOMMERCE
WHERE
	INVOICENO NOT LIKE 'C%'
	AND INVOICENO NOT LIKE 'A%'
	AND UNITPRICE > 0
	AND CUSTOMERID IS NOT NULL;

--average order value
SELECT
	ROUND(
		(
			SUM(QUANTITY * UNITPRICE) / COUNT(DISTINCT INVOICENO)
		)::NUMERIC,
		2
	) AS AVERAGE_ORDER_VALUE
FROM
	ECOMMERCE
WHERE
	INVOICENO NOT LIKE 'C%'
	AND INVOICENO NOT LIKE 'A%'
	AND UNITPRICE > 0
	AND CUSTOMERID IS NOT NULL;

--top 10 bestselling products
SELECT
	DESCRIPTION AS PRODUCT,
	SUM(QUANTITY * UNITPRICE) AS REVENUE
FROM
	ECOMMERCE
WHERE
	INVOICENO NOT LIKE 'C%'
	AND INVOICENO NOT LIKE 'A%'
	AND UNITPRICE > 0
	AND CUSTOMERID IS NOT NULL
GROUP BY
	DESCRIPTION
ORDER BY
	REVENUE DESC
LIMIT
	10;

