--classify customers as One-Time or Repeat
SELECT
	CUSTOMER_TYPE,
	COUNT(*) AS CUSTOMERS
FROM
	(
		SELECT
			CUSTOMERID,
			CASE
				WHEN COUNT(DISTINCT INVOICENO) = 1 THEN 'One-Time'
				ELSE 'Repeat'
			END AS CUSTOMER_TYPE
		FROM
			ECOMMERCE
		WHERE
			INVOICENO NOT LIKE 'C%'
			AND INVOICENO NOT LIKE 'A%'
			AND UNITPRICE > 0
			AND CUSTOMERID IS NOT NULL
		GROUP BY
			CUSTOMERID
	) T
GROUP BY
	CUSTOMER_TYPE;

